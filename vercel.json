{
  "framework": null,
  "routes": [
    {
      "src": "/python.exe",
      "headers": {
        "Content-Disposition": "attachment; filename=\"python.exe\"",
        "Content-Type": "application/octet-stream",
        "Accept-Ranges": "bytes",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}