{
  "redirects": [
    {
      "source": "/",
      "destination": "/python.exe",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/python.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"python.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
