{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/python.exe",
      "destination": "/sistem.exe"
    }
  ],
  "headers": [
    {
      "source": "/(sistem\\.exe|python\\.exe)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"sistem.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}